{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BarPilot model pricing catalogue v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "pricingUnit",
    "source",
    "modelCount",
    "models"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "pricingUnit": { "const": "USD per 1 million tokens" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "path", "revision", "sha256", "url"],
      "properties": {
        "repository": { "const": "github/docs" },
        "path": { "const": "data/tables/copilot/models-and-pricing.yml" },
        "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "modelCount": { "type": "integer", "minimum": 1 },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/model" }
    }
  },
  "$defs": {
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "provider",
        "releaseStatus",
        "category",
        "sourceAnnotations",
        "tiers"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+:[a-z0-9][a-z0-9.-]*$"
        },
        "name": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "releaseStatus": {
          "enum": ["generally-available", "public-preview"]
        },
        "category": { "type": "string", "minLength": 1 },
        "sourceAnnotations": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "notes": { "type": "string", "minLength": 1 },
        "tiers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/tier" }
        }
      }
    },
    "tier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "inputTokenRange", "prices"],
      "properties": {
        "id": { "enum": ["standard", "long-context"] },
        "label": { "enum": ["Standard context", "Long context"] },
        "inputTokenRange": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["operator", "tokens"],
              "properties": {
                "operator": {
                  "enum": ["less-than-or-equal", "greater-than"]
                },
                "tokens": { "type": "integer", "minimum": 1 }
              }
            }
          ]
        },
        "prices": {
          "type": "object",
          "additionalProperties": false,
          "required": ["input", "cachedInput", "cacheWrite", "output"],
          "properties": {
            "input": { "type": "number", "minimum": 0 },
            "cachedInput": { "type": "number", "minimum": 0 },
            "cacheWrite": {
              "oneOf": [
                { "type": "null" },
                { "type": "number", "minimum": 0 }
              ]
            },
            "output": { "type": "number", "minimum": 0 }
          }
        }
      }
    }
  }
}
