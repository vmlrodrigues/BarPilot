{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BarPilot model pricing and community-preference catalogue v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "pricingUnit",
    "source",
    "modelCount",
    "models"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "pricingUnit": { "const": "USD per 1 million tokens" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "path", "revision", "sha256", "url"],
      "properties": {
        "repository": { "const": "github/docs" },
        "path": { "const": "data/tables/copilot/models-and-pricing.yml" },
        "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "communityPreferenceSource": { "$ref": "#/$defs/communityPreferenceSource" },
    "modelCount": { "type": "integer", "minimum": 1 },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/model" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "models": {
            "contains": { "required": ["communityPreference"] }
          }
        }
      },
      "then": { "required": ["communityPreferenceSource"] }
    }
  ],
  "$defs": {
    "communityPreferenceSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publisher",
        "dataset",
        "configuration",
        "split",
        "category",
        "revision",
        "snapshotDate",
        "license",
        "licenseURL",
        "url"
      ],
      "properties": {
        "publisher": { "const": "LM Arena" },
        "dataset": { "const": "lmarena-ai/leaderboard-dataset" },
        "configuration": { "const": "text_style_control" },
        "split": { "const": "latest" },
        "category": { "const": "overall" },
        "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "snapshotDate": { "type": "string", "format": "date" },
        "license": { "const": "CC BY 4.0" },
        "licenseURL": { "const": "https://creativecommons.org/licenses/by/4.0/" },
        "url": { "const": "https://huggingface.co/datasets/lmarena-ai/leaderboard-dataset" }
      }
    },
    "communityPreference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bestRank", "worstRank", "variants"],
      "properties": {
        "bestRank": { "type": "integer", "minimum": 1 },
        "worstRank": { "type": "integer", "minimum": 1 },
        "variants": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/communityPreferenceVariant" }
        }
      }
    },
    "communityPreferenceVariant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arenaModel",
        "label",
        "rank",
        "rating",
        "ratingLower",
        "ratingUpper",
        "voteCount"
      ],
      "properties": {
        "arenaModel": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "rank": { "type": "integer", "minimum": 1 },
        "rating": { "type": "number", "minimum": 0 },
        "ratingLower": { "type": "number", "minimum": 0 },
        "ratingUpper": { "type": "number", "minimum": 0 },
        "voteCount": { "type": "integer", "minimum": 0 }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "provider",
        "releaseStatus",
        "category",
        "sourceAnnotations",
        "tiers"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+:[a-z0-9][a-z0-9.-]*$"
        },
        "name": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "releaseStatus": {
          "enum": ["generally-available", "public-preview"]
        },
        "category": { "type": "string", "minLength": 1 },
        "sourceAnnotations": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "notes": { "type": "string", "minLength": 1 },
        "communityPreference": { "$ref": "#/$defs/communityPreference" },
        "tiers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/tier" }
        }
      }
    },
    "tier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "inputTokenRange", "prices"],
      "properties": {
        "id": { "enum": ["standard", "long-context"] },
        "label": { "enum": ["Standard context", "Long context"] },
        "inputTokenRange": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["operator", "tokens"],
              "properties": {
                "operator": {
                  "enum": ["less-than-or-equal", "greater-than"]
                },
                "tokens": { "type": "integer", "minimum": 1 }
              }
            }
          ]
        },
        "prices": {
          "type": "object",
          "additionalProperties": false,
          "required": ["input", "cachedInput", "cacheWrite", "output"],
          "properties": {
            "input": { "type": "number", "minimum": 0 },
            "cachedInput": { "type": "number", "minimum": 0 },
            "cacheWrite": {
              "oneOf": [
                { "type": "null" },
                { "type": "number", "minimum": 0 }
              ]
            },
            "output": { "type": "number", "minimum": 0 }
          }
        }
      }
    }
  }
}
